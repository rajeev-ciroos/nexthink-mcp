# Copy to .env (git-ignored) and fill in. Configuration is environment variables only.

# Nexthink API, e.g. https://<instance>.api.<region>.nexthink.cloud (see README: this URL shape is an assumption)
NEXTHINK_BASE_URL=https://your-instance.api.your-region.nexthink.cloud
# Replace with your Nexthink API credential. The placeholders below also work with the simulator in docker-compose.
NEXTHINK_CLIENT_ID=sim-client
NEXTHINK_CLIENT_SECRET=change-me-client-secret
# Bearer token clients must send to the HTTP transport (required for --transport http)
NEXTHINK_MCP_AUTH_TOKEN=change-me-generate-with-openssl-rand-hex-32

# --- docker-compose with the simulator (NEXTHINK_BASE_URL is overridden to the simulator) ---
# One of: healthy_baseline, app_rollout_crashes, site_wifi_degradation, windows_update_slow_boot
# SCENARIO=healthy_baseline
# SIM_SEED=42
